<script>
    var addressPrefilled = false;
    function PCinitPrefilledAddress() {
        if(!addressPrefilled) {
            addressPrefilled = true;
            <?php if($getAddr = $this->getRequest()->getParam('address')){ ?>
            setTimeout(function(){
                jQuery('#bh-sl-address').val('<?php echo $getAddr; ?>');
            },100);
            <?php } ?>
        }
    }
</script>

<script>
    var submittedForParams = false;
    function PCsubmitIfHasParams() {
        if(!submittedForParams) {
            submittedForParams = true;
            <?php if(count($this->getRequest()->getParams())) { ?>
            setTimeout(function () {
                jQuery('#bh-sl-submit').trigger('click');
            }, 200);
            <?php } ?>
        }
    }
</script>
